<?xml version="1.0"?>
<!--
  ПРИМЕР URDF ДЛЯ ПРОВЕРКИ ИМПОРТА (этап 12 ТЗ).
  Простая 6-осевая цепь: база → 6 звеньев (прямоугольные корпуса) → TCP.
  Модель учебная: она нужна, чтобы оператор мог сразу проверить импорт
  («Файл → Импорт модели робота» → «Обновить список» → «Импортировать» → «Проверить кинематику»).
  Свою модель положите в ту же папку (StreamingAssets/robots) или в
  «Документы\KazistovVv\robot_models».
-->
<robot name="sample6">
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <geometry><box size="0.22 0.22 0.16"/></geometry>
    </visual>
  </link>

  <joint name="j1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.16" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="120" velocity="2.0"/>
  </joint>
  <link name="link1">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><cylinder radius="0.075" length="0.10"/></geometry>
    </visual>
  </link>

  <joint name="j2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.75" upper="1.75" effort="120" velocity="2.0"/>
  </joint>
  <link name="link2">
    <visual>
      <origin xyz="0 0 0.16" rpy="0 0 0"/>
      <geometry><box size="0.10 0.10 0.42"/></geometry>
    </visual>
  </link>

  <joint name="j3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 0.42" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.35" upper="2.35" effort="90" velocity="2.2"/>
  </joint>
  <link name="link3">
    <visual>
      <origin xyz="0 0 0.14" rpy="0 0 0"/>
      <geometry><box size="0.09 0.09 0.36"/></geometry>
    </visual>
  </link>

  <joint name="j4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0 0 0.36" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.05" upper="3.05" effort="30" velocity="3.0"/>
  </joint>
  <link name="link4">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><cylinder radius="0.055" length="0.10"/></geometry>
    </visual>
  </link>

  <joint name="j5" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.09" upper="2.09" effort="18" velocity="3.2"/>
  </joint>
  <link name="link5">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.08"/></geometry>
    </visual>
  </link>

  <joint name="j6" type="revolute">
    <parent link="link5"/>
    <child link="link6"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-6.28" upper="6.28" effort="12" velocity="3.5"/>
  </joint>
  <link name="link6">
    <visual>
      <origin xyz="0 0 0.035" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.07"/></geometry>
    </visual>
  </link>

  <joint name="tool_joint" type="fixed">
    <parent link="link6"/>
    <child link="tool0"/>
    <origin xyz="0 0 0.07" rpy="0 0 0"/>
  </joint>
  <link name="tool0">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><box size="0.03 0.03 0.04"/></geometry>
    </visual>
  </link>
</robot>
